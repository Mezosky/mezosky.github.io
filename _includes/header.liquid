<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if site.title == 'blank' %}
        {% capture brand_full %}
          {% if site.first_name %}{{ site.first_name }}{% endif %}
          {% if site.middle_name %} {{ site.middle_name }}{% endif %}
          {% if site.last_name %} {{ site.last_name }}{% endif %}
        {% endcapture %}
      {% else %}
        {% assign brand_full = site.title %}
      {% endif %}
      {% assign brand_full = brand_full | strip %}
      {% comment %}
        Captured separately: chaining `slice` after `default` would apply it to
        the configured monogram too and cut it down to a single letter.
      {% endcomment %}
      {% capture brand_initial %}{{ brand_full | slice: 0, 1 }}{% endcapture %}
      {% assign brand_mark = site.brand_monogram | default: brand_initial %}
      {% comment %}
        The wordmark condenses to a monogram once the page is scrolled. Both
        forms are stacked in one grid cell and cross-faded, so the swap costs no
        layout and needs no measurement; #navbar picks up .navbar-condensed from
        assets/js/common.js. Marked aria-hidden with the full name on the link,
        so it is announced once and does not change as the reader scrolls.
      {% endcomment %}
      <a class="navbar-brand title atelier-brand" href="{{ site.baseurl }}/" aria-label="{{ brand_full }}">
        <span class="atelier-brand__full" aria-hidden="true">{{ brand_full }}</span>
        <span class="atelier-brand__mark" aria-hidden="true">{{ brand_mark }}</span>
      </a>

      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        {% include atelier/nav.liquid %}
        <ul class="navbar-nav navbar-utility flex-nowrap">
          {% include atelier/player.liquid %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" title="Search" onclick="openSearchModal()">
                <span class="nav-link">ctrl k <i class="ti ti-search"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="Change theme">
                <i class="ti ti-sun-moon" id="light-toggle-system"></i>
                <i class="ti ti-moon-filled" id="light-toggle-dark"></i>
                <i class="ti ti-sun-filled" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
