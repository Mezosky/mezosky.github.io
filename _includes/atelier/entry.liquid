{% comment %}
  The one-time invitation that can start the top-panel player.

  Renders nothing unless the playlist has tracks and site.audio.invite is on.
  Playback always waits for a click: browsers block autoplay with sound, and an
  academic site should not ambush a visitor with music either. Offered once per
  session and declinable; the control in the panel works either way.

  Starts `hidden` so a reader without JavaScript, and any crawler, sees the page
  itself rather than a gate.
{% endcomment %}

{% assign audio = site.audio %}
{% assign tracks = site.data.playlist %}

{% if tracks and tracks.size > 0 and audio.invite %}
  <div class="atelier-entry" data-entry hidden>
    <div class="atelier-entry__panel" role="dialog" aria-modal="true" aria-labelledby="atelier-entry-prompt">
      {% if audio.epigraph %}
        <blockquote class="atelier-entry__epigraph">
          <p>&ldquo;{{ audio.epigraph | escape }}&rdquo;</p>
          {% if audio.epigraph_source %}
            <cite>&mdash; {{ audio.epigraph_source | escape }}</cite>
          {% endif %}
        </blockquote>
      {% endif %}
      <p class="atelier-entry__prompt" id="atelier-entry-prompt">{{ audio.prompt | default: 'Descend with me' }}</p>
      <div class="atelier-entry__actions">
        <button class="atelier-token atelier-entry__accept" type="button" data-entry-accept>[ Enter ]</button>
        <button class="atelier-entry__decline" type="button" data-entry-decline>
          {{ audio.decline | default: 'Continue in silence' }}
        </button>
      </div>
    </div>
  </div>
{% endif %}
