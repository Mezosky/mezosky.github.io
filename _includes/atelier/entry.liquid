{% comment %}
  Optional entry sound.

  Renders nothing unless site.entry_audio.video_id is set. Playback always waits
  for a click: browsers block autoplay with sound, and an academic site should not
  ambush a visitor with music either. The invitation is offered once per session
  and can be declined; the control stays available afterwards either way.

  Both blocks start `hidden` so a reader without JavaScript, and any crawler, sees
  the page itself rather than a gate.
{% endcomment %}

{% assign audio = site.entry_audio %}

{% if audio.video_id %}
  <div class="atelier-entry" data-entry hidden>
    <div class="atelier-entry__panel" role="dialog" aria-modal="true" aria-labelledby="atelier-entry-prompt">
      <p class="atelier-entry__prompt" id="atelier-entry-prompt">{{ audio.prompt | default: 'Press enter to descend' }}</p>
      {% if audio.title %}
        <p class="atelier-entry__title">{{ audio.title | escape }}</p>
      {% endif %}
      <div class="atelier-entry__actions">
        <button class="atelier-token atelier-entry__accept" type="button" data-entry-accept>[ Enter ]</button>
        <button class="atelier-entry__decline" type="button" data-entry-decline>
          {{ audio.decline | default: 'Continue in silence' }}
        </button>
      </div>
    </div>
  </div>

  <div
    class="atelier-sound"
    data-sound
    data-sound-video="{{ audio.video_id }}"
    data-sound-label="{{ audio.title | default: 'sound' | escape }}"
    hidden
  >
    <button class="atelier-sound__toggle" type="button" data-sound-toggle aria-pressed="false">
      <span class="atelier-sound__state" data-sound-state>[ sound off ]</span>
    </button>
    <div class="atelier-sound__player" data-sound-player></div>
  </div>
{% endif %}
