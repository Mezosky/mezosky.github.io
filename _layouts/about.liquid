---
layout: default
---
{% comment %}
  Homepage. Every block is an include under _includes/atelier/; this file only
  decides the order of the sections and which of them are switched on by the
  page's front matter.
{% endcomment %}

<div class="atelier-home">
  {% include atelier/hero.liquid %}

  <section class="atelier-section" id="research" aria-labelledby="research-title">
    {%
      include atelier/section.liquid
      id="research"
      index="01"
      title="Research"
      note="Four questions, one thread: what a model's internal states reveal that its output does not."
    %}
    {% include atelier/research_index.liquid %}
  </section>

  {% if page.selected_papers %}
    <section class="atelier-section" id="publications" aria-labelledby="publications-title">
      {%
        include atelier/section.liquid
        id="publications"
        index="02"
        title="Publications"
        note="Selected work. Use Cite for ready-to-copy BibTeX."
      %}
      <div class="atelier-publications">{% include selected_papers.liquid %}</div>
      <a class="atelier-more" href="{{ '/publications/' | relative_url }}">[ All publications ]</a>
    </section>
  {% endif %}

  <section class="atelier-section" id="notes" aria-labelledby="notes-title">
    {%
      include atelier/section.liquid
      id="notes"
      index="03"
      title="Notes"
      note="Working notes on machine learning, computer vision, and teaching."
    %}
    {% include atelier/notes.liquid limit=4 %}
    <a class="atelier-more" href="{{ '/blog/' | relative_url }}">[ All notes ]</a>
  </section>

  <section class="atelier-section atelier-section--about" id="about" aria-labelledby="about-title">
    {%
      include atelier/section.liquid
      id="about"
      index="04"
      title="About"
      note=page.subtitle
    %}
    <div class="atelier-about">
      {% unless page.portrait == false %}
        {% include atelier/portrait.liquid %}
      {% endunless %}
      <div class="atelier-prose">{{ content }}</div>
    </div>
    {% if page.social %}
      {% include atelier/links.liquid %}
    {% endif %}
    {% assign ascii_compact = page.ascii_field_compact | default: site.ascii_field_compact %}
    {% include atelier/colophon.liquid field=page.ascii_field compact=ascii_compact %}
  </section>

  {% if page.news and site.announcements.enabled %}
    <section class="atelier-section" id="news" aria-labelledby="news-title">
      {% include atelier/section.liquid id="news" index="05" title="News" %}
      {% include news.liquid limit=true %}
    </section>
  {% endif %}
</div>
